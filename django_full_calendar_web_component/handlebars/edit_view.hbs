{{> headerPartial title="Edit Event" color=color actions=actions}}
<form class="fc-tooltip__body">
  <div>
    <label>Start Date</label>
    <input type="datetime-local"
           class="form-control"
           id="event-start"
           value="{{startDateInput}}">
  </div>
  <div>
    <label>End Date</label>
    <input type="datetime-local"
           class="form-control"
           id="event-end"
           value="{{endDateInput}}">
  </div>
  <div>
    <label>Extra experimental hours</label>
    <input type="number"
           class="form-control"
           min="0"
           id="event-extra-experimental-hours"
           value="{{extra_experimental_hours}}">
  </div>
  <div>
    <label>Sample preparation hours</label>
    <input type="number"
           class="form-control"
           min="0"
           id="event-sample-preparation-hours"
           value="{{sample_preparation_hours}}">
  </div>
  <div>
    <label>Data analysis hours</label>
    <input type="number"
           class="form-control"
           min="0"
           id="event-data-analysis-hours"
           value="{{data_analysis_hours}}">
  </div>
  <div>
    <label>Note</label>
    <textarea class="form-control"
              id="event-note"
              rows="2">{{note}}</textarea>
  </div>
  <div class="d-flex justify-content-end gap-2 mt-3 mb-1">
    <button type="button" class="btn btn-success" id="save-btn">
      <i class="fas fa-save"></i> Save Changes
    </button>
    <button type="button" class="btn btn-secondary" id="cancel-btn">
      <i class="fas fa-times"></i> Cancel
    </button>
  </div>
</form>
