{{> headerPartial title="Edit Event" color=color actions=actions}}
<form class="fc-tooltip__body">
  <div>
    <label class="m-0">Start Date</label>
    <input type="datetime-local"
           class="form-control"
           id="event-start"
           value="{{startDateInput}}">
  </div>
  <div>
    <label class="m-0">End Date</label>
    <input type="datetime-local"
           class="form-control"
           id="event-end"
           value="{{endDateInput}}">
  </div>
  <div>
    <label class="m-0">Extra experimental hours</label>
    <input type="number"
           class="form-control"
           id="event-extra-experimental-hours"
           value="{{extra_experimental_hours}}">
  </div>
  <div>
    <label class="m-0">Sample preparation hours</label>
    <input type="number"
           class="form-control"
           id="event-sample-preparation-hours"
           value="{{sample_preparation_hours}}">
  </div>
  <div>
    <label class="m-0">Data analysis hours</label>
    <input type="number"
           class="form-control"
           id="event-data-analysis-hours"
           value="{{data_analysis_hours}}">
  </div>
  <div>
    <label class="m-0">Note</label>
    <textarea class="form-control"
          id="event-note">{{note}}</textarea>
  </div>
  <div class="d-flex justify-content-end mt-2 mb-1">
    <button type="button" class="btn btn-success ms-2" id="save-btn">
      <i class="fa fa-fw fa-save"></i> Save Changes
    </button>
    <button type="button" class="btn btn-secondary" id="cancel-btn">
      <i class="fa fa-fw fa-times"></i> Cancel
    </button>
  </div>
</form>
